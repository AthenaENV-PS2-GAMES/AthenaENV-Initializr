# Base URL of the AthenaEnv build server (no trailing slash). Empty = local mode.
NEXT_PUBLIC_ATHENA_BUILD_API=
# Static catalog used when the build server is unavailable.
NEXT_PUBLIC_ATHENA_CATALOG_URL=https://athenaenv-ps2-games.github.io/AthenaEnv/catalog.json
# 1 = fall back to the bundled fixture catalog and a simulated build server (development only).
NEXT_PUBLIC_ATHENA_MOCK=
